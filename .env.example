# Solinteg account credentials. Keep these private - never commit .env to git.
SOLINTEG_USERNAME=
SOLINTEG_PASSWORD=

# Monitoring configuration
DASHBOARD_URL=https://www.solinteg-cloud.com/power-station/detail?id=68907e47c99c9350eaad9377&name=Rishi%20Valley%20100%20kW
SOC_THRESHOLD=40
SOC_REARM_MARGIN=2

# How often to read the page (seconds, minimum 10)
CHECK_INTERVAL_SECONDS=60

# How often to reload the dashboard to refresh data (seconds, minimum 60)
PAGE_RELOAD_INTERVAL_SECONDS=300

# Set to true to run without a visible browser window (required for cloud deployment)
HEADLESS=false

# ── Email alert settings ──────────────────────────────────────────────────────
# Email address to send the alert TO
ALERT_TO_EMAIL=bhuvaneshravi1957@gmail.com

# Your Gmail address that SENDS the alert
GMAIL_FROM_EMAIL=

# 16-character Gmail App Password (NOT your Gmail login password).
# Generate one at: https://myaccount.google.com/apppasswords
# Requires 2-Step Verification to be enabled on your Google account.
GMAIL_APP_PASSWORD=

# ── Login selectors (optional) ────────────────────────────────────────────────
# Leave all three selectors BLANK for manual login (recommended for first run).
# Only fill these after inspecting the actual live login page with DevTools.
LOGIN_USERNAME_SELECTOR=
LOGIN_PASSWORD_SELECTOR=
LOGIN_BUTTON_SELECTOR=
