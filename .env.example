# Solinteg account credentials. Keep these private - never commit .env to git.
SOLINTEG_USERNAME=
SOLINTEG_PASSWORD=

# â”€â”€ Sites to monitor â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# To add a new site: copy a SITE_N block, increment N, fill URL and NAME.
# SITE_N_THRESHOLD and SITE_N_REARM_MARGIN are optional (fall back to defaults).

SITE_1_NAME=Rishi Valley 100 kW
SITE_1_URL=https://www.solinteg-cloud.com/power-station/detail?id=68907e47c99c9350eaad9377&name=Rishi%20Valley%20100%20kW
SITE_1_THRESHOLD=40

SITE_2_NAME=Rishi Valley 50kW
SITE_2_URL=https://www.solinteg-cloud.com/power-station/detail?id=688dfecf0aaff53a4b137f60&name=Rishi%20Valley%2050kw
SITE_2_THRESHOLD=40

# Add more sites below â€” no code changes needed:
# SITE_3_NAME=Boson Chennai Test
# SITE_3_URL=https://www.solinteg-cloud.com/power-station/detail?id=...
# SITE_3_THRESHOLD=40

# â”€â”€ Global defaults (used if SITE_N_THRESHOLD not set) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
SOC_THRESHOLD=40
SOC_REARM_MARGIN=2

# How often to read each site (seconds, minimum 10)
CHECK_INTERVAL_SECONDS=60

# How often to reload each site dashboard (seconds, minimum 60)
PAGE_RELOAD_INTERVAL_SECONDS=300

# Set to true to run without a visible browser window (required for cloud)
HEADLESS=true

# â”€â”€ Email alert settings â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
ALERT_TO_EMAIL=bhuvaneshravi1957@gmail.com
GMAIL_FROM_EMAIL=
GMAIL_APP_PASSWORD=

# â”€â”€ Login selectors (optional â€” leave blank for manual login) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
LOGIN_USERNAME_SELECTOR=#basic_account
LOGIN_PASSWORD_SELECTOR=#basic_pwd
LOGIN_BUTTON_SELECTOR=button[type="submit"]
